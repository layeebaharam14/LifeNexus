# ==========================================
# LIFENEXUS Backend - Phase 3 Configuration
# ==========================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/lifenexus
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lifenexus?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Ingestion & Storage Sandbox
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
