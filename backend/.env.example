# ==========================================
# LIFENEXUS Backend - Production Configuration
# ==========================================

# Server Settings (Render assigns PORT automatically via $PORT)
PORT=5000
NODE_ENV=production

# CORS Allowed Origin (Set to your deployed Vercel frontend URL)
# Multiple origins can be comma-separated: https://lifenexus.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-lifenexus-frontend.vercel.app

# Database Configuration (MongoDB Atlas)
# Replace <username>, <password>, and <cluster> with your Atlas credentials
# If unset or unreachable, LIFENEXUS runs with resilient in-memory storage fallback
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifenexus?retryWrites=true&w=majority

# Authentication Secrets (Generate a secure random string of 32+ characters)
JWT_SECRET=replace_with_a_secure_production_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# File Storage Configuration
# Note: On Render free web services, the local filesystem is ephemeral.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Phase 4A - Gemini AI Settings
# Optional: Leave empty to run with deterministic local semantic extraction
# If provided, use gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_DOCUMENT_TEXT_CHARS=25000
DOCUMENT_UNDERSTANDING_TIMEOUT_MS=300000
