# ==========================================
# LIFENEXUS - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/lifenexus
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lifenexus?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# AI Intelligence API Key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage Sandbox Path
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
