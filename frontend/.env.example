# ==========================================
# LIFENEXUS Frontend Environment Configuration
# ==========================================

# In Local Development:
# Leave empty or set to /api (uses Vite local proxy to http://localhost:5000)
# VITE_API_URL=/api

# In Production (Vercel):
# Set this to your deployed Render backend URL (with or without /api)
# Example: https://lifenexus-api.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api
